---
interface Props {
  size?: "sm" | "md" | "lg" | "xl" | "full";
  class?: string;
}

const { size = "xl", class: className } = Astro.props;

// xl mirrors the original site's Tailwind `container` (1280px at desktop).
const sizes = {
  sm: "max-w-3xl",
  md: "max-w-4xl",
  lg: "max-w-6xl",
  xl: "max-w-7xl",
  full: "max-w-none",
} as const;
---

<div class:list={["mx-auto w-full px-4 lg:px-8", sizes[size], className]}>
  <slot />
</div>
