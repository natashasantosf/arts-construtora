---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = "size-4", label } = Astro.props;
const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox}
  fill={icon.filled ? "currentColor" : "none"}
  stroke={icon.filled ? undefined : "currentColor"}
  stroke-width={icon.filled ? undefined : 2}
  stroke-linecap={icon.filled ? undefined : "round"}
  stroke-linejoin={icon.filled ? undefined : "round"}
  class:list={["shrink-0", className]}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  set:html={icon.body}
/>
