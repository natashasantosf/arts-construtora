---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "section"> = Polymorphic<{ as: Tag }> & {
  tone?: "default" | "muted" | "primary" | "accent" | "deep";
  spacing?: "none" | "xs" | "sm" | "md" | "lg" | "xl";
};

const { as: Tag = "section", tone = "default", spacing = "xl", class: className, ...rest } = Astro.props;

const tones = {
  default: "bg-background text-foreground",
  muted: "bg-muted text-foreground",
  primary: "bg-primary text-primary-foreground",
  accent: "bg-accent text-accent-foreground",
  deep: "bg-accent-deep text-accent-deep-foreground",
} as const;

// Vertical rhythm of the original site: xl is its `section-pad` (py-20, py-28 on desktop).
const spacings = {
  none: "",
  xs: "py-5",
  sm: "py-12",
  md: "py-16",
  lg: "py-20",
  xl: "py-20 lg:py-28",
} as const;
---

<Tag class:list={[tones[tone], spacings[spacing], className]} {...rest}>
  <slot />
</Tag>
