---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "h2"> = Polymorphic<{ as: Tag }> & {
  size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl" | "display";
  weight?: "bold" | "black";
  tone?: "default" | "inverse" | "primary";
};

const { as: Tag = "h2", size = "3xl", weight = "black", tone = "default", class: className, ...rest } =
  Astro.props;

// Responsive scale taken from the original pages (mobile, then md/lg).
const sizes = {
  xs: "text-sm",
  sm: "text-base",
  md: "text-lg",
  lg: "text-xl md:text-2xl",
  xl: "text-2xl md:text-3xl",
  "2xl": "text-2xl md:text-4xl",
  "3xl": "text-3xl md:text-4xl",
  "4xl": "text-3xl md:text-5xl",
  "5xl": "text-4xl md:text-5xl",
  "6xl": "text-4xl md:text-6xl",
  display: "text-4xl md:text-5xl lg:text-7xl leading-none",
} as const;

const weights = { bold: "font-bold", black: "font-black" } as const;
const tones = { default: "text-foreground", inverse: "text-inverse", primary: "text-primary" } as const;
---

<Tag
  class:list={["font-sans tracking-tight", sizes[size], weights[weight], tones[tone], className]}
  {...rest}
>
  <slot />
</Tag>
