---
import type { IconName } from "@/components/atoms/icons";
import Icon from "./Icon.astro";

interface Props {
  icon: IconName;
  size?: "sm" | "md" | "lg";
  variant?: "soft" | "solid";
  class?: string;
}

const { icon, size = "lg", variant = "soft", class: className } = Astro.props;

const sizes = { sm: "size-8", md: "size-10", lg: "size-12" } as const;
const iconSizes = { sm: "size-4", md: "size-5", lg: "size-6" } as const;
const variants = {
  // group-hover inverts the box when the parent card turns primary (ServiceCard, value cards).
  soft: "bg-primary/10 text-primary group-hover:bg-inverse/20 group-hover:text-inverse",
  solid: "bg-primary text-primary-foreground",
} as const;
---

<div
  class:list={[
    "flex shrink-0 items-center justify-center transition-colors",
    sizes[size],
    variants[variant],
    className,
  ]}
>
  <Icon name={icon} class={iconSizes[size]} />
</div>
