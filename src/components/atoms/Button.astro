---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "button"> = Polymorphic<{ as: Tag }> & {
  variant?: "primary" | "secondary" | "accent" | "outline" | "outline-inverse" | "ghost" | "danger";
  size?: "sm" | "base" | "md" | "lg";
  block?: boolean;
};

const {
  as: Tag = "button",
  variant = "primary",
  size = "md",
  block = false,
  class: className,
  ...rest
} = Astro.props;

const variants = {
  primary: "bg-primary text-primary-foreground hover:bg-primary-hover",
  // White button with brand text, used on primary-colored bands.
  secondary: "bg-secondary text-secondary-foreground hover:bg-secondary-hover",
  accent: "bg-accent text-accent-foreground hover:opacity-90",
  outline: "border-2 border-primary text-primary hover:bg-primary hover:text-primary-foreground",
  // Translucent white outline, used on dark or primary backgrounds.
  "outline-inverse": "border-2 border-inverse/40 text-inverse hover:border-inverse hover:bg-inverse/10",
  ghost: "text-foreground hover:bg-muted",
  danger: "bg-danger text-danger-foreground hover:opacity-90",
} as const;

// Paddings copied from the original buttons. Pick a size instead of overriding
// padding with `class` — conflicting utilities resolve by CSS order, not class order.
const sizes = {
  sm: { x: "px-5", y: "py-2.5 text-sm" },
  base: { x: "px-6", y: "py-2.5 text-base" },
  md: { x: "px-8", y: "py-3 text-base" },
  lg: { x: "px-8", y: "py-4 text-base" },
} as const;
---

<Tag
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-sm font-bold transition-colors duration-200",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
    "disabled:pointer-events-none disabled:opacity-60",
    variants[variant],
    sizes[size].y,
    // Full-width buttons in the original have no horizontal padding.
    block ? "w-full" : sizes[size].x,
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
