---
import type { IconName } from "@/components/atoms/icons";
import Container from "@/components/atoms/Container.astro";
import Section from "@/components/atoms/Section.astro";
import DividedGrid from "@/components/atoms/DividedGrid.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import ServiceCard from "@/components/molecules/ServiceCard.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import type { ComponentProps } from "astro/types";

interface Item {
  title: string;
  description: string;
  icon?: IconName;
  href?: string;
}

// Hairline grid of ServiceCards, optionally with a section header and a "see all" button.
interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  items: Item[];
  linkLabel?: string;
  cardHeadingAs?: "h2" | "h3";
  cardSize?: "sm" | "md" | "lg";
  justify?: boolean;
  headingSize?: ComponentProps<typeof SectionHeading>["size"];
  cta?: { label: string; href: string };
  tone?: ComponentProps<typeof Section>["tone"];
  spacing?: ComponentProps<typeof Section>["spacing"];
  class?: string;
}

const {
  eyebrow,
  heading,
  text,
  items,
  linkLabel,
  cardHeadingAs,
  cardSize,
  justify,
  headingSize,
  cta,
  tone = "muted",
  spacing = "xl",
  class: className,
} = Astro.props;
---

<Section tone={tone} spacing={spacing} class={className}>
  <Container>
    {heading && <SectionHeading eyebrow={eyebrow} heading={heading} text={text} size={headingSize} class="mb-16" />}
    <DividedGrid>
      {
        items.map((item) => (
          <div>
            <ServiceCard
              title={item.title}
              icon={item.icon}
              href={item.href}
              linkLabel={linkLabel}
              headingAs={cardHeadingAs}
              size={cardSize}
              justify={justify}
            >
              {item.description}
            </ServiceCard>
          </div>
        ))
      }
    </DividedGrid>
    {
      cta && (
        <div class="mt-10 text-center">
          <Button as="a" href={cta.href} variant="outline">
            {cta.label}
            <Icon name="arrow-right" class="size-4" />
          </Button>
        </div>
      )
    }
  </Container>
</Section>
