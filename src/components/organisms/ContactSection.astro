---
import Container from "@/components/atoms/Container.astro";
import Section from "@/components/atoms/Section.astro";
import Button from "@/components/atoms/Button.astro";
import QuoteCard from "@/components/molecules/QuoteCard.astro";
import InfoItem from "@/components/molecules/InfoItem.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import type { IconName } from "@/components/atoms/icons";
import { site } from "@/data/site";

// Quote request form + contact sidebar.
interface Props {
  heading: string;
  text: string;
  serviceOptions: { value: string; label: string }[];
  whatsappHref: string;
  phone: { display: string; href: string };
  email: string;
  location: string;
  locationNote: string;
  hours: string[];
  social: { label: string; href: string; icon: IconName }[];
  class?: string;
}

const {
  heading,
  text,
  serviceOptions,
  whatsappHref,
  phone,
  email,
  location,
  locationNote,
  hours,
  social,
  class: className,
} = Astro.props;

const field =
  "flex w-full rounded-md border border-border bg-transparent px-3 text-base shadow-sm transition-colors placeholder:text-muted-foreground focus:border-primary focus:ring-1 focus:ring-primary focus-visible:outline-none md:text-sm";
const label = "text-sm font-semibold text-foreground";
---

<Section spacing="lg" class={className}>
  <Container>
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="mb-2 text-2xl font-black text-foreground">{heading}</h2>
        <p class="mb-8 text-sm text-muted-foreground">{text}</p>

        <!--
          Submitted to worker/index.ts (POST /api/contato), which checks the Turnstile captcha, stores it in D1
          and forwards it by e-mail. The captcha needs JS, so submissions without JS are rejected.
        -->
        <form id="formulario" class="scroll-mt-32 space-y-5" action="/api/contato" method="post" data-quote-form>
          <!-- Honeypot: hidden from people, filled in by bots; the Worker discards those submissions. -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Não preencha este campo</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="nome" class={label}>Nome completo *</label>
              <input id="nome" name="nome" required maxlength="120" autocomplete="name" placeholder="João da Silva" class:list={[field, "h-9 py-1"]} />
            </div>
            <div class="space-y-2">
              <label for="telefone" class={label}>Telefone / WhatsApp *</label>
              <input id="telefone" name="telefone" type="tel" required maxlength="40" autocomplete="tel" placeholder="(51) 99999-9999" class:list={[field, "h-9 py-1"]} />
            </div>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="email" class={label}>E-mail *</label>
              <input id="email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="joao@empresa.com.br" class:list={[field, "h-9 py-1"]} />
            </div>
            <div class="space-y-2">
              <label for="cidade" class={label}>Cidade *</label>
              <input id="cidade" name="cidade" required maxlength="120" autocomplete="address-level2" placeholder="Porto Alegre" class:list={[field, "h-9 py-1"]} />
            </div>
          </div>
          <div class="space-y-2">
            <label for="servico" class={label}>Tipo de serviço *</label>
            <select id="servico" name="servico" required class:list={[field, "h-9 py-2 text-sm"]}>
              <option value="">Selecione o serviço desejado...</option>
              {serviceOptions.map((option) => <option value={option.label}>{option.label}</option>)}
            </select>
          </div>
          <div class="space-y-2">
            <label for="mensagem" class={label}>Descreva o serviço desejado *</label>
            <textarea
              id="mensagem"
              name="mensagem"
              required
              maxlength="5000"
              rows="5"
              placeholder="Ex: Prédio de 12 andares em Porto Alegre, fachada com pastilhas descascando e fissuras. Preciso de vistoria técnica e orçamento para reforma completa da fachada."
              class:list={[field, "min-h-[60px] resize-none py-2"]}
            ></textarea>
          </div>
          <!-- Cloudflare Turnstile captcha; rendered by the script below, verified by the Worker. -->
          <div data-turnstile data-sitekey={site.turnstileSiteKey} class="min-h-[65px]"></div>
          <Button type="submit" size="lg" block class="tracking-wide" data-submit>Enviar Solicitação de Orçamento</Button>
          <p data-form-status role="status" aria-live="polite" hidden class="border px-4 py-3 text-sm"></p>
          <p class="text-center text-xs text-muted-foreground/80">
            Seus dados são protegidos. Não compartilhamos informações com terceiros.
          </p>
        </form>
      </div>

      <aside class="space-y-6">
        <QuoteCard
          size="md"
          heading="Resposta Rápida"
          text="Para orçamentos urgentes, fale diretamente com nossa equipe técnica."
          whatsapp={{ label: "WhatsApp Agora", href: whatsappHref }}
          phone={{ label: phone.display, href: phone.href }}
        />

        <div class="space-y-5 border border-border p-6">
          <h3 class="border-b border-border pb-3 text-sm font-bold tracking-widest text-foreground uppercase">
            Informações
          </h3>
          <InfoItem icon="phone" label="Telefone">
            <a href={phone.href} class="text-sm text-muted-foreground transition-colors hover:text-primary">{phone.display}</a>
          </InfoItem>
          <InfoItem icon="mail" label="E-mail">
            <a href={`mailto:${email}`} class="text-sm break-all text-muted-foreground transition-colors hover:text-primary">{email}</a>
          </InfoItem>
          <InfoItem icon="map-pin" label="Localização">
            <p class="text-sm text-muted-foreground">{location}</p>
            <p class="mt-1 text-xs text-muted-foreground/80">{locationNote}</p>
          </InfoItem>
          <InfoItem icon="clock" label="Horário">
            {hours.map((line) => <p class="text-sm text-muted-foreground">{line}</p>)}
          </InfoItem>
        </div>

        <div class="border border-border p-6">
          <p class="mb-4 text-sm font-bold tracking-widest text-foreground uppercase">Redes Sociais</p>
          <SocialLinks links={social} size="md" class="gap-3" />
        </div>
      </aside>
    </div>
  </Container>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const submit = form?.querySelector<HTMLButtonElement>("[data-submit]");

  // Turnstile is rendered explicitly so the widget can be reset after each attempt (tokens are single-use).
  const container = form?.querySelector<HTMLElement>("[data-turnstile]");
  let widgetId: string | undefined;
  type Turnstile = {
    render(el: HTMLElement, options: Record<string, unknown>): string;
    reset(id?: string): void;
  };
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  if (container) {
    (window as unknown as Record<string, unknown>).onTurnstileLoad = () => {
      widgetId = turnstile()?.render(container, {
        sitekey: container.dataset.sitekey,
        action: "contato",
        language: "pt-br",
      });
    };
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad";
    script.async = true;
    document.head.append(script);
  }

  const messages = {
    success: "Recebemos sua solicitação! Nossa equipe técnica retorna em até 24 horas.",
    error: "Não foi possível enviar agora. Tente novamente ou fale com a gente pelo WhatsApp.",
  };

  function show(kind: "success" | "error", text = messages[kind]) {
    if (!status) return;
    status.textContent = text;
    status.hidden = false;
    status.className =
      "border px-4 py-3 text-sm " +
      (kind === "success" ? "border-success bg-success/10 text-foreground" : "border-danger bg-danger/10 text-foreground");
  }

  // Result of a no-JS submission (the Worker redirects back with ?enviado=1 or ?erro=1).
  const params = new URLSearchParams(location.search);
  if (params.has("enviado")) show("success");
  if (params.has("erro")) show("error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submit || submit.disabled) return;
    if (!new FormData(form).get("cf-turnstile-response")) {
      show("error", "Aguarde a verificação anti-robô (logo acima do botão) e tente de novo.");
      return;
    }
    submit.disabled = true;
    const label = submit.textContent;
    submit.textContent = "Enviando...";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (response.ok && result.ok) {
        form.reset();
        show("success");
      } else {
        show("error", result.error ?? messages.error);
      }
    } catch {
      show("error");
    } finally {
      if (widgetId !== undefined) turnstile()?.reset(widgetId);
      submit.disabled = false;
      submit.textContent = label;
    }
  });
</script>
