---
import Container from "@/components/atoms/Container.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import Logo from "@/components/atoms/Logo.astro";
import NavLink from "@/components/molecules/NavLink.astro";

interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

interface Props {
  nav: NavItem[];
  currentPath: string;
  cta: { label: string; href: string };
  phone: { display: string; href: string };
  whatsappHref: string;
  tagline: string;
  /** Transparent over the page until the user scrolls (home page). */
  transparent?: boolean;
  class?: string;
}

const { nav, currentPath, cta, phone, whatsappHref, tagline, transparent = false, class: className } = Astro.props;

const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<div
  class:list={[
    "hidden items-center justify-end gap-6 px-8 py-2 text-xs font-medium text-inverse/80 transition-all duration-300 lg:flex",
    transparent ? "bg-scrim/30" : "bg-accent",
  ]}
>
  <a href={phone.href} class="flex items-center gap-1.5 transition-colors hover:text-primary">
    <Icon name="phone" class="size-3" />
    {phone.display}
  </a>
  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 transition-colors hover:text-primary">
    <Icon name="whatsapp" class="size-3" />
    WhatsApp
  </a>
  <span class="text-inverse/40">|</span>
  <span class="tracking-widest uppercase">{tagline}</span>
</div>

<header
  data-site-header
  data-transparent={transparent ? "" : undefined}
  class:list={[
    "sticky top-0 z-50 w-full transition-all duration-300",
    transparent ? "bg-transparent py-5" : "border-b border-border bg-background py-3 shadow-lg",
    className,
  ]}
>
  <Container class="flex items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center">
      <Logo class={`w-auto transition-all duration-300 ${transparent ? "h-14" : "h-12"}`} />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        nav.map((item) =>
          item.children ? (
            <div class="group relative">
              <NavLink href={item.href} active={isActive(item.href)} class="flex items-center gap-1">
                {item.label}
                <Icon name="chevron-down" class="size-3 transition-transform group-hover:rotate-180" />
              </NavLink>
              <div class="invisible absolute top-full left-0 z-50 min-w-60 translate-y-1 border border-border bg-card opacity-0 shadow-xl transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block border-b border-border px-5 py-3 text-sm text-foreground transition-colors last:border-0 hover:bg-primary hover:text-primary-foreground"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <NavLink href={item.href} active={isActive(item.href)}>
              {item.label}
            </NavLink>
          ),
        )
      }
    </nav>

    <!-- Visibility lives on a wrapper: `hidden` passed to Button would lose to its own `inline-flex`. -->
    <div class="hidden lg:block">
      <Button as="a" href={cta.href} target="_blank" rel="noopener noreferrer" size="sm">
        <Icon name="whatsapp" class="size-4" />
        {cta.label}
      </Button>
    </div>

    <button
      type="button"
      class="relative z-50 p-2 text-foreground transition-colors lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Icon name="menu" class="size-6 [[aria-expanded=true]>&]:hidden" />
      <Icon name="x" class="hidden size-6 [[aria-expanded=true]>&]:block" />
    </button>
  </Container>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  class="fixed inset-0 z-40 flex translate-x-full flex-col overflow-y-auto bg-accent px-6 pt-20 pb-8 transition-transform duration-300 data-[open]:translate-x-0 lg:hidden"
>
  <nav class="mt-4 flex flex-col gap-1" aria-label="Menu móvel">
    {
      nav.map((item) => (
        <div>
          <a
            href={item.href}
            class:list={[
              "block border-b border-inverse/10 px-2 py-3 text-lg font-bold transition-colors",
              isActive(item.href) ? "text-primary" : "text-inverse hover:text-primary",
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="bg-inverse/5 pl-4">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block border-b border-inverse/5 px-2 py-2 text-sm text-inverse/70 transition-colors hover:text-primary"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </nav>
  <Button as="a" href={cta.href} target="_blank" rel="noopener noreferrer" size="lg" block class="mt-8">
    <Icon name="whatsapp" class="size-4" />
    {cta.label}
  </Button>
  <a
    href={phone.href}
    class="mt-3 flex items-center justify-center gap-2 rounded-sm border border-inverse/20 py-3 text-sm text-inverse/80 transition-colors hover:border-primary"
  >
    <Icon name="phone" class="size-4" />
    {phone.display}
  </a>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  // Transparent header (home) turns solid once the page scrolls, like the original.
  if (header?.hasAttribute("data-transparent")) {
    const solid = ["bg-background", "shadow-lg", "py-3", "border-b", "border-border"];
    const clear = ["bg-transparent", "py-5"];
    const update = () => {
      const scrolled = window.scrollY > 40 || menu?.hasAttribute("data-open");
      header.classList.toggle("is-scrolled", Boolean(scrolled));
      solid.forEach((c) => header.classList.toggle(c, Boolean(scrolled)));
      clear.forEach((c) => header.classList.toggle(c, !scrolled));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    toggle?.addEventListener("click", () => requestAnimationFrame(update));
  }

  toggle?.addEventListener("click", () => {
    const open = !menu?.hasAttribute("data-open");
    menu?.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    document.body.classList.toggle("overflow-hidden", open);
  });
</script>
