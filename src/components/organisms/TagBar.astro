---
import Container from "@/components/atoms/Container.astro";
import Section from "@/components/atoms/Section.astro";
import Chip from "@/components/atoms/Chip.astro";

// Row of category chips under a page banner (portfolio, blog). Labels only — not filters.
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<Section spacing="xs" class:list={["border-b border-border", className]}>
  <Container>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => <Chip class="cursor-default">{tag}</Chip>)}
    </div>
  </Container>
</Section>
