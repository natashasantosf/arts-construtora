---
import Container from "@/components/atoms/Container.astro";
import Section from "@/components/atoms/Section.astro";
import Stat from "@/components/molecules/Stat.astro";

interface Item {
  value: string | number;
  label: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<Section tone="primary" spacing="md" class={className}>
  <Container>
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {items.map((item) => <Stat value={item.value} label={item.label} />)}
    </div>
  </Container>
</Section>
