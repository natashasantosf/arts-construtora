---
import Container from "@/components/atoms/Container.astro";
import Section from "@/components/atoms/Section.astro";
import FaqItem from "@/components/molecules/FaqItem.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";

interface Item {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: Item[];
  class?: string;
}

const { eyebrow, heading, items, class: className } = Astro.props;
---

<Section class={className}>
  <Container size="sm">
    <SectionHeading eyebrow={eyebrow} heading={heading} class="mb-16" />
    <div class="space-y-2">
      {items.map((item) => <FaqItem question={item.question}>{item.answer}</FaqItem>)}
    </div>
  </Container>
</Section>
