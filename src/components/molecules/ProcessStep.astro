---
interface Props {
  index: number | string;
  title: string;
  class?: string;
}

const { index, title, class: className } = Astro.props;
---

<div class:list={["flex items-start gap-5 border border-border p-6", className]}>
  <div
    class="flex size-8 shrink-0 items-center justify-center bg-primary text-sm font-black text-primary-foreground"
  >
    {index}
  </div>
  <div>
    <div class="mb-1 font-bold text-foreground">{title}</div>
    <p class="text-sm leading-relaxed text-muted-foreground">
      <slot />
    </p>
  </div>
</div>
