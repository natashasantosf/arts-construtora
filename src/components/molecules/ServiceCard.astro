---
import type { IconName } from "@/components/atoms/icons";
import IconBox from "@/components/atoms/IconBox.astro";
import Icon from "@/components/atoms/Icon.astro";

interface Props {
  title: string;
  icon?: IconName;
  href?: string;
  linkLabel?: string;
  headingAs?: "h2" | "h3";
  size?: "sm" | "md" | "lg";
  /** Justified body copy, as on the "Empresa" values grid. */
  justify?: boolean;
  class?: string;
}

const {
  title,
  icon,
  href,
  linkLabel = "Saiba mais",
  headingAs: HeadingTag = "h3",
  size = "md",
  justify = false,
  class: className,
} = Astro.props;

const Wrapper = href ? "a" : "div";
---

<Wrapper
  href={href}
  class:list={[
    "group block h-full bg-card p-8 transition-all duration-300 hover:bg-primary",
    href && "cursor-pointer",
    className,
  ]}
>
  {icon && <IconBox icon={icon} class="mb-5" />}
  <HeadingTag
    class:list={[
      "mb-3 font-bold text-foreground transition-colors group-hover:text-inverse",
      { sm: "text-base", md: "text-lg", lg: "text-xl" }[size],
    ]}
  >
    {title}
  </HeadingTag>
  <p
    class:list={[
      "text-sm leading-relaxed text-muted-foreground transition-colors group-hover:text-inverse/80",
      href && (size === "lg" ? "mb-5" : "mb-4"),
      justify && "text-justify",
    ]}
  >
    <slot />
  </p>
  {
    href && (
      <span class="flex items-center gap-1 text-sm font-bold text-primary transition-colors group-hover:text-inverse">
        {linkLabel}
        <Icon name="arrow-right" class="size-4" />
      </span>
    )
  }
</Wrapper>
