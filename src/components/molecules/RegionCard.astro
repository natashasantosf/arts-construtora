---
import Icon from "@/components/atoms/Icon.astro";
import Badge from "@/components/atoms/Badge.astro";
import Chip from "@/components/atoms/Chip.astro";

interface Props {
  name: string;
  status: string;
  description: string;
  cities: string[];
  class?: string;
}

const { name, status, description, cities, class: className } = Astro.props;
---

<div class:list={["bg-card p-8", className]}>
  <div class="mb-5 flex items-start gap-4">
    <div class="flex size-10 shrink-0 items-center justify-center bg-primary">
      <Icon name="map-pin" class="size-5 text-inverse" />
    </div>
    <div>
      <div class="mb-1 flex items-center gap-2">
        <h2 class="text-xl font-black text-foreground">{name}</h2>
        <Badge variant="soft" size="sm">{status}</Badge>
      </div>
      <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    {cities.map((city) => <Chip variant="small">{city}</Chip>)}
  </div>
</div>
