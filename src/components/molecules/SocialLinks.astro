---
import type { IconName } from "@/components/atoms/icons";
import Icon from "@/components/atoms/Icon.astro";

interface Item {
  label: string;
  href: string;
  icon: IconName;
}

interface Props {
  links: Item[];
  /** inverse: for dark backgrounds (footer) */
  tone?: "default" | "inverse";
  size?: "sm" | "md";
  class?: string;
}

const { links, tone = "default", size = "sm", class: className } = Astro.props;
---

<ul class:list={["flex items-center", size === "sm" ? "gap-4" : "gap-3", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "flex items-center justify-center border transition-colors hover:border-primary hover:text-primary",
            size === "sm" ? "size-9" : "size-10",
            tone === "inverse" ? "border-inverse/20 text-inverse/60" : "border-border text-muted-foreground/80",
          ]}
        >
          <Icon name={link.icon} class="size-4" />
        </a>
      </li>
    ))
  }
</ul>
