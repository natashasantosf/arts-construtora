---
// Big number + caption, designed for the primary-colored stats band.
interface Props {
  value: string | number;
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={["text-center", className]}>
  <div class="mb-2 text-5xl font-black lg:text-6xl">{value}</div>
  <div class="text-sm font-semibold tracking-widest uppercase opacity-80">{label}</div>
</div>
