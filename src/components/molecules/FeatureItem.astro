---
import Icon from "@/components/atoms/Icon.astro";

// Outlined feature tile for dark bands ("Por que nos escolher").
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div
  class:list={[
    "border border-inverse/10 bg-inverse/5 p-6 transition-colors hover:border-primary/50",
    className,
  ]}
>
  <Icon name="circle-check" class="mb-3 size-6 text-primary" />
  <h3 class="mb-2 text-sm font-bold text-inverse">{title}</h3>
  <p class="text-sm leading-relaxed text-inverse/50">
    <slot />
  </p>
</div>
