---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "@/components/atoms/Badge.astro";

interface Props {
  title: string;
  category: string;
  image: ImageMetadata;
  imageAlt: string;
  summary?: string;
  href?: string;
  /** overlay: caption over the photo (home) · card: photo above text (portfolio) */
  variant?: "overlay" | "card";
  headingAs?: "h2" | "h3";
  class?: string;
}

const {
  title,
  category,
  image,
  imageAlt,
  summary,
  href,
  variant = "card",
  headingAs: HeadingTag = variant === "card" ? "h2" : "h3",
  class: className,
} = Astro.props;

const Wrapper = href ? "a" : "div";
---

{
  variant === "overlay" ? (
    <div class:list={["group relative overflow-hidden", className]}>
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        class="h-72 w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-x-0 bottom-0 flex flex-col justify-end bg-gradient-to-t from-scrim/60 via-scrim/20 to-transparent p-6 pt-16">
        <Badge class="mb-2">{category}</Badge>
        <HeadingTag class="text-base font-bold text-inverse">{title}</HeadingTag>
      </div>
    </div>
  ) : (
    <div class:list={["group overflow-hidden bg-card", className]}>
      <Wrapper href={href} class="block h-full">
        <div class="h-56 overflow-hidden">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <div class="p-6">
          <Badge class="mb-3">{category}</Badge>
          <HeadingTag class="mb-2 text-base font-bold text-foreground">{title}</HeadingTag>
          {summary && <p class="text-sm leading-relaxed text-muted-foreground">{summary}</p>}
        </div>
      </Wrapper>
    </div>
  )
}
