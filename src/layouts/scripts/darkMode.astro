<script is:inline>
// On page load or when changing themes, best to add inline in `head` to avoid FOUC
// FOLLOW_OS_BY_DEFAULT is off: the converted site had no dark mode, so it opens light
// unless the visitor explicitly chooses dark (or respectOSPreference() is called).
const FOLLOW_OS_BY_DEFAULT = false;
if(localStorage.theme === "dark" || (FOLLOW_OS_BY_DEFAULT && !("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)){
    document.documentElement.dataset['theme'] = "dark"  
}

// Whenever the user explicitly chooses light mode
function setLightMode() {
    localStorage.theme = "light";
    document.documentElement.dataset['theme'] = "light";
}

// Whenever the user explicitly chooses dark mode
function setDarkMode() {
    localStorage.theme = "dark";
    document.documentElement.dataset['theme'] = "dark";
}

// Whenever the user explicitly chooses to respect the OS preference
function respectOSPreference() {
    localStorage.removeItem("theme");
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.dataset['theme'] = "dark";
    } else {
        delete document.documentElement.dataset['theme'];
    }
}
</script>