---
import { getCollection } from "astro:content";
import type { ComponentProps } from "astro/types";
import Head from "./head.astro"
import Header from "@/components/organisms/Header.astro";
import Footer from "@/components/organisms/Footer.astro";
import WhatsAppFloat from "@/components/organisms/WhatsAppFloat.astro";
import { site, whatsappUrl } from "@/data/site";
import { localBusiness } from "@/data/structured-data";
import { publicPath } from "@/utils/paths";

interface Props {
	meta: ComponentProps<typeof Head>;
	/** Header floats transparent over the page until scroll (home page). */
	transparentHeader?: boolean;
	/** Hide the site chrome (header, footer, floating button), e.g. for landing pages. */
	bare?: boolean;
}

const { meta, transparentHeader = false, bare = false } = Astro.props;

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const serviceLinks = services.map((s) => ({ label: s.data.title, href: `/servicos/${s.id}` }));

const nav = site.nav.map((item) => ({
	label: item.label,
	href: item.href,
	children: item.children === "services" ? serviceLinks : undefined,
}));

const areaLinks = (cities: string[]) => cities.map((city) => ({ label: city, href: "/areas-atendidas" }));
---
<!doctype html>
<html lang={site.locale}>
	<head>
		<Head {...meta} jsonLd={[localBusiness, ...(meta.jsonLd ?? [])]} />
	</head>
	<body class="flex min-h-screen flex-col">
		{!bare && (
			<Header
				nav={nav}
				currentPath={publicPath(Astro.url.pathname)}
				cta={{ label: "Solicitar Orçamento", href: whatsappUrl() }}
				phone={site.phone}
				whatsappHref={whatsappUrl()}
				tagline={site.regionTagline}
				transparent={transparentHeader}
			/>
		)}
		<main class="flex-1">
			<slot />
		</main>
		{!bare && (
			<Footer
				siteName={site.name}
				taglines={site.servicesTagline}
				contacts={[
					{ icon: "phone", label: site.phone.display, href: site.phone.href },
					{ icon: "whatsapp", label: "WhatsApp", href: whatsappUrl(), external: true },
					{ icon: "mail", label: site.email, href: `mailto:${site.email}` },
					{ icon: "map-pin", label: site.location },
				]}
				social={site.social.map((s) => ({ label: s.name, href: s.href, icon: s.icon as "instagram" | "facebook" }))}
				services={serviceLinks}
				areas={{
					title: "Áreas Atendidas",
					primary: areaLinks(site.featuredCities.rs),
					secondaryTitle: "Santa Catarina",
					secondary: areaLinks(site.featuredCities.sc),
				}}
				guarantees={site.guarantees.map((g) => ({ icon: g.icon as "shield" | "award", text: g.text }))}
				bottom={[`© ${new Date().getFullYear()} ${site.name}. Todos os direitos reservados.`, site.values, site.location]}
			/>
		)}
		{!bare && <WhatsAppFloat href={whatsappUrl()} />}
		<script>
			import "@/utils/animation-classes";

			type PostHogClient = {
				capture: (event: string, properties?: Record<string, unknown>) => void;
			};

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;
				const link = event.target.closest<HTMLAnchorElement>("a[href]");
				if (!link) return;

				// Read on each click: the loader stub in window.posthog is replaced once the library loads.
				const posthog = (window as typeof window & { posthog?: PostHogClient }).posthog;
				if (link.href.startsWith("https://wa.me/")) {
					posthog?.capture("whatsapp_contact_started");
				} else if (link.href.startsWith("tel:")) {
					posthog?.capture("phone_contact_started");
				}
			});
		</script>
	</body>
</html>
