---
import { getCollection } from "astro:content";
import Layout from "@/layouts/main.astro";
import Container from "@/components/atoms/Container.astro";
import Heading from "@/components/atoms/Heading.astro";
import Text from "@/components/atoms/Text.astro";
import Button from "@/components/atoms/Button.astro";
import Badge from "@/components/atoms/Badge.astro";
import Chip from "@/components/atoms/Chip.astro";
import Divider from "@/components/atoms/Divider.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import Icon from "@/components/atoms/Icon.astro";
import IconBox from "@/components/atoms/IconBox.astro";
import Logo from "@/components/atoms/Logo.astro";
import DividedGrid from "@/components/atoms/DividedGrid.astro";
import { iconNames } from "@/components/atoms/icons";
import Alert from "@/components/molecules/Alert.astro";
import Breadcrumbs from "@/components/molecules/Breadcrumbs.astro";
import ThemeToggle from "@/components/molecules/ThemeToggle.astro";
import ServiceCard from "@/components/molecules/ServiceCard.astro";
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import CheckItem from "@/components/molecules/CheckItem.astro";
import ProcessStep from "@/components/molecules/ProcessStep.astro";
import FaqItem from "@/components/molecules/FaqItem.astro";
import FeatureItem from "@/components/molecules/FeatureItem.astro";
import Stat from "@/components/molecules/Stat.astro";
import Testimonial from "@/components/molecules/Testimonial.astro";
import QuoteCard from "@/components/molecules/QuoteCard.astro";
import InfoItem from "@/components/molecules/InfoItem.astro";
import RegionCard from "@/components/molecules/RegionCard.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import CTASection from "@/components/organisms/CTASection.astro";
import { site, whatsappUrl } from "@/data/site";

const meta = {
  title: "Design System",
  description: "Tokens e componentes do site da Art's Construtora",
  noindex: true,
};

const [featured] = await getCollection("featuredProjects");
const [region] = await getCollection("regions");

// Literal class strings on purpose — Tailwind's build-time scanner can only
// see classes that appear as-written in source, not ones assembled from
// interpolated variables (e.g. `bg-${name}` would silently produce nothing).
const surfaceTokens = [
  { name: "background", class: "bg-background" },
  { name: "foreground", class: "bg-foreground" },
  { name: "card", class: "bg-card" },
  { name: "muted", class: "bg-muted" },
  { name: "muted-foreground", class: "bg-muted-foreground" },
  { name: "border", class: "bg-border" },
  { name: "ring", class: "bg-ring" },
];

const brandTokens = [
  { name: "primary", class: "bg-primary" },
  { name: "primary-hover", class: "bg-primary-hover" },
  { name: "primary-foreground", class: "bg-primary-foreground" },
  { name: "secondary", class: "bg-secondary" },
  { name: "secondary-foreground", class: "bg-secondary-foreground" },
  { name: "accent", class: "bg-accent" },
  { name: "accent-deep", class: "bg-accent-deep" },
  { name: "accent-foreground", class: "bg-accent-foreground" },
];

const extraTokens = [
  { name: "rating", class: "bg-rating" },
  { name: "whatsapp", class: "bg-whatsapp" },
  { name: "success", class: "bg-success" },
  { name: "warning", class: "bg-warning" },
  { name: "danger", class: "bg-danger" },
];

const headingSizes = ["xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl", "5xl", "6xl", "display"] as const;
const lightButtons = ["primary", "outline", "accent", "ghost", "danger"] as const;
const buttonSizes = ["sm", "base", "md", "lg"] as const;
const badgeVariants = ["primary", "soft", "outline", "accent", "neutral"] as const;
---

<Layout {meta}>
  <Container class="py-10">
    <Breadcrumbs items={[{ label: "Início", href: "/" }, { label: "Design system" }]} />

    <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
      <div class="max-w-2xl space-y-2">
        <Heading as="h1" size="4xl">Design system</Heading>
        <Text>
          Referência viva dos tokens e componentes do site, convertidos do site original. Toda cor vem de
          <code>src/styles/global.css</code>; todo bloco de página é um componente em <code>src/components</code>.
          Esta página não é indexada nem aparece na navegação.
        </Text>
      </div>
      <div class="flex items-center gap-2">
        <Button size="sm" variant="outline" onclick="setLightMode()">Claro</Button>
        <Button size="sm" variant="outline" onclick="setDarkMode()">Escuro</Button>
        <ThemeToggle />
      </div>
    </div>
  </Container>

  <Divider />

  <Container class="space-y-16 py-12">
    <section class="space-y-6">
      <Heading size="xl">Cores</Heading>
      {
        [
          { label: "Superfícies e texto", tokens: surfaceTokens },
          { label: "Marca", tokens: brandTokens },
          { label: "Complementares", tokens: extraTokens },
        ].map((group) => (
          <div class="space-y-3">
            <p class="text-sm font-semibold text-muted-foreground">{group.label}</p>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-8">
              {group.tokens.map((token) => (
                <div class="space-y-2">
                  <div class:list={["h-16 border border-border", token.class]} />
                  <p class="text-xs text-muted-foreground">{token.name}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="space-y-6">
      <Heading size="xl">Marca</Heading>
      <div class="flex flex-wrap items-center gap-8">
        <Logo class="h-14 w-auto" />
        <div class="bg-accent-deep p-4"><Logo tone="inverse" class="h-14 w-auto" /></div>
        <Eyebrow>Eyebrow</Eyebrow>
        <Eyebrow line>Eyebrow com linha</Eyebrow>
      </div>
    </section>

    <section class="space-y-6">
      <Heading size="xl">Tipografia — Montserrat</Heading>
      <div class="space-y-3">
        {headingSizes.map((size) => <Heading as="p" size={size}>{`Heading ${size}`}</Heading>)}
        <Heading as="p" size="md" weight="bold">Heading md, weight bold</Heading>
      </div>
      <div class="max-w-2xl space-y-2">
        <Text size="lg">Text lg — parágrafos de introdução.</Text>
        <Text>Text base — corpo padrão, tom muted.</Text>
        <Text size="sm" tone="default">Text sm, tom default.</Text>
      </div>
    </section>

    <section class="space-y-6">
      <Heading size="xl">Botões</Heading>
      <div class="flex flex-wrap gap-3">
        {lightButtons.map((variant) => <Button variant={variant}>{variant}</Button>)}
      </div>
      <div class="flex flex-wrap gap-3 bg-primary p-6">
        <Button variant="secondary">secondary</Button>
        <Button variant="outline-inverse">outline-inverse</Button>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        {buttonSizes.map((size) => <Button size={size}>{`size ${size}`}</Button>)}
      </div>
    </section>

    <section class="space-y-6">
      <Heading size="xl">Badges, chips e ícones</Heading>
      <div class="flex flex-wrap gap-3">
        {badgeVariants.map((variant) => <Badge variant={variant}>{variant}</Badge>)}
      </div>
      <div class="flex flex-wrap gap-3">
        <Chip>tag</Chip>
        <Chip variant="city" icon="map-pin">city</Chip>
        <Chip variant="small">small</Chip>
      </div>
      <div class="flex flex-wrap gap-4 text-foreground">
        {iconNames.map((name) => (
          <span class="flex w-24 flex-col items-center gap-1 text-center">
            <Icon name={name} class="size-5" />
            <span class="text-[10px] text-muted-foreground">{name}</span>
          </span>
        ))}
      </div>
      <div class="flex gap-3">
        <IconBox icon="hard-hat" />
        <IconBox icon="map-pin" size="md" variant="solid" />
      </div>
    </section>

    <section class="space-y-6">
      <Heading size="xl">Moléculas</Heading>
      <SectionHeading eyebrow="SectionHeading" heading="Título de seção" text="Texto de apoio centralizado, como nas seções da home." />
      <DividedGrid>
        <div><ServiceCard title="ServiceCard com link" icon="paint-roller" href="#">Passe o mouse: o card inteiro assume a cor primária.</ServiceCard></div>
        <div><ServiceCard title="ServiceCard sem link" icon="users" size="sm" justify>Variante usada nos valores da página Empresa.</ServiceCard></div>
        {featured && <ProjectCard variant="overlay" title={featured.data.title} category={featured.data.category} image={featured.data.image} imageAlt={featured.data.imageAlt} />}
      </DividedGrid>
      <div class="grid gap-3 md:grid-cols-2">
        <CheckItem>CheckItem — item de "O que está incluído"</CheckItem>
        <ProcessStep index={1} title="ProcessStep">Etapa numerada de "Como trabalhamos".</ProcessStep>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <FaqItem question="FaqItem — pergunta?">Resposta em &lt;details&gt;, sem JavaScript.</FaqItem>
        <InfoItem icon="phone" label="InfoItem"><p class="text-sm text-muted-foreground">{site.phone.display}</p></InfoItem>
      </div>
      <div class="grid gap-6 bg-accent p-6 md:grid-cols-2">
        <FeatureItem title="FeatureItem">Tile para faixas escuras.</FeatureItem>
        <Testimonial quote="Testimonial — depoimento com estrelas." name="Nome" role="Cargo" />
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="bg-primary py-8 text-primary-foreground"><Stat value="480+" label="Stat" /></div>
        <QuoteCard
          heading="QuoteCard"
          text={site.quoteText}
          whatsapp={{ label: "WhatsApp", href: whatsappUrl() }}
          phone={{ label: site.phone.display, href: site.phone.href }}
        />
      </div>
      {region && <DividedGrid cols="md2"><RegionCard {...region.data} /></DividedGrid>}
      <Alert variant="info" title="Alert">Mantido do template para mensagens de sistema.</Alert>
    </section>
  </Container>

  <CTASection
    heading="CTASection"
    text="Organismos usados nas páginas: Hero, PageHero, TrustBar, Services, WhyUs, StatsSection, ProjectShowcase, CityGrid, TestimonialsSection, FAQ, CTASection, LeadSection, TagBar, ServiceDetail, ProjectGrid, PostsSection, RegionsGrid, CityColumns, MapEmbed, ContactStrip, ContactSection, AboutStory, MissionVision, Timeline."
    ctas={[{ label: "Ver a home", href: "/" }]}
  />
</Layout>
