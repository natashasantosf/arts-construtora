{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker connected to Workers Builds.
  "name": "arts-construtora",
  "compatibility_date": "2026-09-26",
  // Only handles /api/* (contact form); everything else is the static Astro build.
  "main": "./worker/index.ts",
  // Static site: Astro builds to dist/ (build.format "file" → /servicos/x is served from servicos/x.html).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Contact form submissions (schema in migrations/).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arts-construtora-contatos",
      "database_id": "53c44daf-e69d-455a-89b7-16984baab4a9",
      "migrations_dir": "migrations"
    }
  ],
  // Turnstile captcha on the contact form. The secret is a Worker secret: `wrangler secret put TURNSTILE_SECRET`.
  "vars": {
    "EMAIL_TO": "comercial@artsconstrutora.com.br",
    "TURNSTILE_HOSTNAMES": "artsconstrutora.com.br"
  },
  // E-mail forwarding is ready in worker/index.ts but off until artsconstrutora.com.br uses
  // Cloudflare DNS and is onboarded to Email Sending. Then add here (and in "previews"):
  //   "send_email": [{ "name": "EMAIL" }],
  //   and "EMAIL_FROM": "site@artsconstrutora.com.br" in "vars".
  "observability": { "enabled": true },
  // workers.dev Preview URLs for non-production branches (`npx wrangler preview`).
  "preview_urls": true,
  // Previews don't inherit bindings or vars. While the preview is the site receiving real
  // contacts, it writes to the same database as production.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "arts-construtora-contatos",
        "database_id": "53c44daf-e69d-455a-89b7-16984baab4a9",
        "migrations_dir": "migrations"
      }
    ],
    // For the captcha to work on a preview, add its workers.dev hostname here and to the Turnstile widget.
    "vars": {
      "EMAIL_TO": "comercial@artsconstrutora.com.br",
      "TURNSTILE_HOSTNAMES": "artsconstrutora.com.br"
    }
  }
}
