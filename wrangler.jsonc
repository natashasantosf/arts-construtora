{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker connected to Workers Builds.
  "name": "arts-construtora",
  "compatibility_date": "2026-09-29",
  // Static site: Astro builds to dist/ (build.format "file" → /servicos/x is served from servicos/x.html).
  "assets": {
    "directory": "./dist"
  },
  // workers.dev Preview URLs for non-production branches (`npx wrangler preview`).
  "preview_urls": true,
  // Required by `wrangler preview`; empty because the site has no bindings or vars.
  "previews": {}
}
